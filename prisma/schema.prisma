generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  timezone         String            @default("America/Santo_Domingo")
  workDays         String            @default("Mon,Tue,Wed,Thu,Fri")
  startHour        String            @default("09:00")
  endHour          String            @default("18:00")
  slotBufferMin    Int               @default(15)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  whatsappAccounts WhatsAppAccount[]
  serviceTypes     ServiceType[]
  leads            Lead[]
  appointments     Appointment[]
  agentConfig      AgentConfig?
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  name           String
  passwordHash   String
  role           Role         @default(ADMIN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WhatsAppAccount {
  id             String    @id @default(uuid())
  organizationId String
  phoneNumber    String    @unique
  displayName    String?
  status         String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, PAIRING
  qrCode         String?
  lastConnected  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ServiceType {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  durationMinutes Int           @default(30)
  price           Float         @default(0.0)
  description     String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum LeadStatus {
  NEW
  QUALIFIED
  BOOKED
  UNQUALIFIED
  HANDOVER
}

model Lead {
  id             String        @id @default(uuid())
  organizationId String
  phone          String
  name           String?
  email          String?
  status         LeadStatus    @default(NEW)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments    Appointment[]
  chatMessages    ChatMessage[]
  bookingSession  BookingSession?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@index([phone])
}

enum BookingStep {
  IDLE
  AWAITING_SERVICE
  AWAITING_DATE
  AWAITING_TIME
}

model BookingSession {
  id             String      @id @default(uuid())
  leadId         String      @unique
  organizationId String
  step           BookingStep @default(IDLE)
  serviceTypeId  String?
  selectedDate   String?
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Appointment {
  id                    String            @id @default(uuid())
  organizationId        String
  leadId                String
  serviceTypeId         String
  startTime             DateTime
  endTime               DateTime
  status                AppointmentStatus @default(SCHEDULED)
  notes                 String?
  googleCalendarEventId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reminders             Reminder[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceType  ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@index([startTime])
  @@index([status])
}

model AgentConfig {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  botName            String   @default("Schedule Bot")
  greetingMessage    String   @default("¡Hola! Soy tu asistente de agendamiento. ¿En qué te puedo ayudar hoy?")
  systemPrompt       String   @default("Eres un asistente experto en agendamiento de citas en WhatsApp. Tu objetivo es ayudar al cliente a agendar, consultar o reagendar su cita.")
  autoBookingEnabled Boolean  @default(true)
  escalationKeyword  String   @default("humano,asesor,representante")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum MessageSender {
  LEAD
  AI_AGENT
  HUMAN
}

model ChatMessage {
  id        String        @id @default(uuid())
  leadId    String
  sender    MessageSender
  content   String
  createdAt DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model Reminder {
  id            String         @id @default(uuid())
  appointmentId String
  scheduledFor  DateTime
  status        ReminderStatus @default(PENDING)
  channel       String         @default("WHATSAPP")
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
}
